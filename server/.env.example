# Copy to server/.env  (or set as real environment variables on your host)
PORT=8787
DATA_DIR=./data
CACHE_MB=2048
# 1 = serve HTTPS with an auto-generated self-signed certificate (needed for LAN use, see README)
HTTPS=0
# 1 = no public STUN (pure offline LAN)
CW_OFFLINE=0
# Optional: custom ICE servers as JSON, e.g. [{"urls":"stun:stun.example.org:3478"}]
ICE_SERVERS=
# Optional coturn (ephemeral credentials, must match deploy/turnserver.conf static-auth-secret)
TURN_URL=
TURN_SECRET=
# Set to 1 when behind a reverse proxy / PaaS that terminates TLS
TRUST_PROXY=0
